---
import Orbit from './Orbit.astro';
import WorkVisual from './WorkVisual.astro';
import {experience,stories} from '../data/portfolio';
const {kind}=Astro.props;
const tracks=[['Joe Hisaishi','Studio Ghibli works'],['Hans Zimmer','Interstellar'],['Evan Call','Frieren'],['Succession','Theme'],['Demon Slayer','Theme'],['Neon Genesis Evangelion','Theme'],['KK','Artist rotation'],['Atif Aslam','Artist rotation']];
---
{kind==='intro' && <section class="hero-grid"><div class="hero-copy"><p class="mono"><span class="signal-dot">●</span> PERSONAL SPACE / ARYAN BASANTANI</p><h1>Building things.<br/>Connecting<br/><em>the dots.</em></h1><p class="hero-deck">Product, technology & finance.<br/>I turn complex workflows into things people can use.</p><div class="hero-actions"><a class="key key-orange" href="#selected">Explore my work ↓</a><a class="key" href="/resume.pdf">Résumé ↗</a></div><p class="status-line">OPEN TO PRODUCT & TECHNICAL PM ROLES</p></div><div class="hero-machine"><Orbit/><div class="launch-bar"><div class="launch-lights" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div><button id="launch" class="key launch-key" type="button" hidden>IGNITION ↗</button><span id="launch-status" class="mono" role="status">READY WHEN YOU ARE</span></div></div></section>}
{kind==='experience' && <section class="experience-panel" aria-labelledby="exp-title"><div class="panel-label"><h2 id="exp-title">01 / THE FLIGHT LOG</h2><a href="/about/#experience">Full context ↗</a></div><div class="flight-log">{experience.map((job,i)=><article><span class="log-index">0{i+1}</span><h3>{job.company}</h3><p>{job.role}</p><small>{job.dates}</small></article>)}</div></section>}
{kind==='work' && <section id="selected" class="work-section"><div class="section-heading"><div><p class="mono">02 / SELECTED MISSIONS</p><h2>Work, in the real world.</h2></div><a class="key" href="/work/">All work & projects ↗</a></div><div class="mission-grid">{stories.filter(s=>s.selected).map((story,i)=><article class="mission-card"><div class="mission-top"><span>CASE / 0{i+1}</span><span>↗</span></div><a href={`/work/${story.slug}/`} class="mission-art" aria-label={`Read ${story.title}`}><WorkVisual kind={story.visual} compact/></a><div class="mission-copy"><span class="mono">{story.kind}</span><h3><a href={`/work/${story.slug}/`}>{story.title}</a></h3><p>{story.deck}</p><a class="case-link" href={`/work/${story.slug}/`}>Open case file <span>↗</span></a></div></article>)}</div></section>}
{kind==='interests' && <section id="interests"><div class="section-heading"><div><p class="mono">03 / OFF DUTY</p><h2>Other frequencies.</h2></div><span class="mono">A FEW THINGS IN MY ORBIT</span></div><div class="interest-grid">
<article class="interest music-panel"><div class="panel-label"><h3>LISTENING ROOM</h3><span>FM / AB</span></div><div class="tape" aria-hidden="true"><div class="tape-label">SOUNDTRACKS<br/>& LONG-TIME FAVOURITES</div><div class="reels"><i></i><span></span><i></i></div><div class="tape-slot"></div></div><div class="track-caption"><strong id="track-artist">Joe Hisaishi</strong><span id="track-title">Studio Ghibli works</span></div><div class="tape-controls" hidden id="tape-controls"><button class="key" id="prev-track" aria-label="Previous music pick">←</button><span class="mono" id="track-number">01 / 08</span><button class="key" id="next-track" aria-label="Next music pick">→</button></div><details><summary>View the rotation</summary><ol class="track-list">{tracks.map(t=><li><strong>{t[0]}</strong><span>{t[1]}</span></li>)}</ol></details><p class="tiny">A shelf of favourites, not an audio player.</p></article>
<article class="interest anime-panel"><div class="panel-label"><h3>ANIME CHANNEL</h3><span>ON REPEAT</span></div><div class="anime-screen"><div class="sun-disc" aria-hidden="true"><span>★</span><span>★</span><span>★</span><span>★</span></div><div class="anime-title">DRAGON<br/><b>BALL Z</b></div><span class="mono">ALL-TIME FAVOURITE</span></div><details><summary>Beyond the favourite</summary><p>Monster · Psycho-Pass S1 · Frieren · Cowboy Bebop · Neon Genesis Evangelion.</p></details></article>
<article class="interest racing-panel"><div class="panel-label"><h3>RACE WEEKEND</h3><span>01</span></div><svg viewBox="0 0 340 155" role="img" aria-label="Original racing circuit illustration"><path d="M42 105C4 54 58 20 112 43L225 33Q313 20 300 76L272 125Q238 153 217 103L171 82Q119 143 42 105Z" fill="none" stroke="currentColor" stroke-width="12"/><path d="M42 105C4 54 58 20 112 43L225 33Q313 20 300 76L272 125Q238 153 217 103L171 82Q119 143 42 105Z" fill="none" stroke="var(--panel)" stroke-width="1" stroke-dasharray="4 7"/><circle class="race-dot" cx="111" cy="43" r="9" fill="#ee6538"/></svg><h3>Max. Red Bull.<br/>Lights out.</h3><p class="tiny">Following the racing—and the engineering decisions behind it.</p></article>
<article class="interest market-panel"><div class="panel-label"><h3>ON MY RADAR</h3><span>MACRO</span></div><div class="chip-art" aria-hidden="true"><b>Si</b><span>SUPPLY → PRICES</span></div><h3>Oil. Chips. Everyday prices.</h3><p class="tiny">Where geopolitics meets the technology we buy.</p></article>
<article class="interest place-panel"><div class="panel-label"><h3>HOME SIGNAL</h3><span>IST</span></div><div class="globe" aria-hidden="true"><i></i><i></i><i></i><span>●</span></div><h3>India / Earth</h3><p class="tiny">Computer Science + Finance<br/>BITS Pilani, Hyderabad</p></article>
<article class="interest shelf-panel"><div class="panel-label"><h3>THE SHELF</h3><span>BOOKS / FILM</span></div><div class="shelf-art" aria-hidden="true"><i></i><i></i><i></i><div>◉<br/>◉</div></div><h3>Room for a few favourites.</h3><p class="tiny">Books and film selections are still being curated.</p></article>
</div></section>}
{kind==='notes' && <section id="notes" class="notes-section"><div class="section-heading"><div><p class="mono">04 / FIELD NOTES</p><h2>Things that stayed with me.</h2></div><span class="mono">FROM THE WORK</span></div><div class="notes-grid"><a href="/work/moveinsync-analytics/"><span class="note-tab">01 / PRODUCT</span><h3>A low number is useful when you can explain it.</h3><p>Why metric-to-record drilldowns mattered more than another dashboard.</p><span>Read the decision ↗</span></a><a href="/work/shubh-bazaar/"><span class="note-tab">02 / BUILDING</span><h3>Checkout is not the end of the product.</h3><p>What building through payments and fulfilment taught me.</p><span>Read the build ↗</span></a></div></section>}
{kind==='chat' && <section id="comms" class="comms-panel"><div class="comms-intro"><p class="mono">05 / OPEN COMMS</p><div class="bot-face" aria-hidden="true"><i></i><i></i><span></span></div><h2>Meet the<br/>co-pilot.</h2><p>A Gemini-powered guide to my work.<br/>Ask about a project, my experience or where I might fit.</p><span class="tiny">AI answers can be wrong. Check the linked portfolio sources.</span></div><div class="chat-console" data-endpoint={import.meta.env.PUBLIC_CHAT_ENDPOINT || ''}><div class="console-top"><span>AB / CO-PILOT</span><button id="clear-chat" type="button" hidden>Clear</button></div><div id="chat-log" class="chat-log" role="log" aria-label="Portfolio conversation" aria-live="polite"><p class="bot-message">Where would you like to start?</p></div><div class="chat-prompts"><button type="button" data-prompt="What did Aryan own at MoveInSync?">MoveInSync ↗</button><button type="button" data-prompt="What has Aryan built end to end?">Things built ↗</button><button type="button" data-prompt="Summarise Aryan's finance background.">Finance ↗</button></div><form id="chat-form"><label class="sr-only" for="chat-input">Ask about Aryan’s work</label><input id="chat-input" maxlength="600" required placeholder="Ask about my work…" autocomplete="off"/><button class="key key-orange" id="send-chat" type="submit">Send ↗</button><button class="key" id="cancel-chat" type="button" hidden>Cancel</button></form><p id="chat-status" class="tiny" role="status">Messages are sent to Google via a private-key server endpoint. Please leave out sensitive information.</p><noscript><p>Chat needs JavaScript. Work and contact remain available above.</p></noscript></div></section>}
