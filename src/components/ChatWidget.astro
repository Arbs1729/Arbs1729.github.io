<div class="chat-widget" transition:persist="chat-widget">
  <button id="chat-launcher" class="chat-launcher" type="button" hidden aria-expanded="false" aria-controls="chat-panel">
    <span aria-hidden="true">✦</span><span>Ask about Aryan</span>
  </button>
  <section id="chat-panel" class="chat-panel" hidden aria-labelledby="chat-title" role="dialog">
    <div class="chat-panel-head">
      <div><p class="mono">PORTFOLIO CO-PILOT</p><h2 id="chat-title">Ask about Aryan</h2></div>
      <button id="close-chat" type="button" aria-label="Close chat">×</button>
    </div>
    <div class="chat-console" data-endpoint={import.meta.env.PUBLIC_CHAT_ENDPOINT || ''}>
      <div id="chat-log" class="chat-log" role="log" aria-label="Portfolio conversation" aria-live="polite">
        <p class="bot-message">Ask about my work, projects, background or interests.</p>
      </div>
      <div class="chat-prompts">
        <button type="button" data-prompt="What did Aryan own at MoveInSync?">MoveInSync</button>
        <button type="button" data-prompt="What has Aryan built end to end?">Things built</button>
        <button type="button" data-prompt="Summarise Aryan's finance background.">Finance</button>
        <button type="button" data-prompt="What does Aryan enjoy outside work?">Interests</button>
      </div>
      <form id="chat-form">
        <label class="sr-only" for="chat-input">Ask about Aryan</label>
        <input id="chat-input" maxlength="600" required placeholder="Ask a portfolio question…" autocomplete="off" />
        <button class="key key-orange" id="send-chat" type="submit">Send</button>
        <button class="key" id="cancel-chat" type="button" hidden>Cancel</button>
      </form>
      <div class="chat-meta"><p id="chat-status" class="tiny" role="status">The AI guide is not connected in this preview yet.</p><button id="clear-chat" type="button" hidden>Clear conversation</button></div>
      <noscript><p class="tiny">Chat needs JavaScript. The rest of the portfolio remains available.</p></noscript>
    </div>
  </section>
</div>
