---
import '../styles/global.css';
import '../styles/deck.css';
import '../styles/revamp.css';
import {person} from '../data/portfolio';
import ChatWidget from './ChatWidget.astro';
import Atmosphere from './Atmosphere.astro';
import BrandMark from './BrandMark.astro';
const {title='Product, technology & finance',description=person.description,immersive=false}=Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site || 'https://aryanbasantani.me');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title} — {person.name}</title>
  <meta name="description" content={description}/>
  <meta name="robots" content="index,follow"/>
  <meta name="color-scheme" content="dark light"/>
  <link rel="canonical" href={canonical}/>
  <meta property="og:title" content={`${title} — ${person.name}`}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={canonical}/>
  <link rel="icon" href="/favicon.svg"/>
  <script is:inline>try{const saved=localStorage.getItem('aryan-theme');const theme=saved==='system'||saved==='light'||saved==='dark'?saved:'dark';if(theme==='system')delete document.documentElement.dataset.theme;else document.documentElement.dataset.theme=theme;}catch{document.documentElement.dataset.theme='dark';}</script>
</head>
<body class:list={{"immersive-home":immersive}}>
  <a class="skip" href="#main">Skip to content</a>
  <Atmosphere/>
  <slot name="arrival"/>
  <div class="shell deck-shell">
    <header class="deck-header">
      <a class="deck-brand" href="/" aria-label="Aryan Basantani home"><BrandMark/></a>
      <nav aria-label="Main navigation">
        <a href="/work/" aria-current={path.startsWith('/work') ? 'page' : undefined}>Work</a>
        <a href="/interests/" aria-current={path.startsWith('/interests') ? 'page' : undefined}>Interests</a>
        <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
        <a href="#contact">Get in touch</a>
      </nav>
      <div class="deck-settings">
        <button id="intro-replay" type="button" hidden aria-label="Play intro animation">
          <span class="intro-replay-glyph" aria-hidden="true">▶</span>
          <span id="intro-replay-label">Play intro</span>
        </button>
        <button id="theme-toggle" type="button" hidden><span aria-hidden="true">◐</span> <span id="theme-label">Dark</span></button>
      </div>
    </header>
    <main id="main"><slot/></main>
    <footer id="contact" class="deck-footer">
      <a class="footer-back-to-top" href="#main">Back to top ↑</a>
      <div class="footer-bottom"><span>ARYAN BASANTANI</span><span>Made with ♥</span><span>INDIA · 2026</span></div>
    </footer>
  </div>
  <ChatWidget/>
  <script is:inline src="/theme.js" defer></script>
  <script is:inline src="/atmosphere.js" defer></script>
  <script is:inline src="/deck.js" defer></script>
  {immersive && <script is:inline src="/arrival.js" defer></script>}
</body>
</html>
