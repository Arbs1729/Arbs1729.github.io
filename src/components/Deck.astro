---
import '../styles/global.css';
import '../styles/deck.css';
import '../styles/revamp.css';
import {person} from '../data/portfolio';
import ChatWidget from './ChatWidget.astro';
import Atmosphere from './Atmosphere.astro';
import BrandMark from './BrandMark.astro';
import GlobalMusicPlayer from './GlobalMusicPlayer.astro';
import BookingSheet from './BookingSheet.astro';
import { ClientRouter } from 'astro:transitions';
const {title='Product, technology & finance',description=person.description,immersive=false,noindex=false}=Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site || 'https://aryanbasantani.me');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title} — {person.name}</title>
  <meta name="description" content={description}/>
  {noindex ? <meta name="robots" content="noindex,follow"/> : <meta name="robots" content="index,follow"/>}
  <meta name="color-scheme" content="dark light"/>
  <link rel="canonical" href={canonical}/>
  <meta property="og:title" content={`${title} — ${person.name}`}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={canonical}/>
  <link rel="icon" href="/favicon.svg"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,SOFT,wght@0,9..144,50,400..600;1,9..144,50,400..500&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"/>
  <ClientRouter />
  <script is:inline>try{const saved=localStorage.getItem('aryan-theme');const theme=saved==='system'||saved==='light'||saved==='dark'?saved:'dark';if(theme==='system')delete document.documentElement.dataset.theme;else document.documentElement.dataset.theme=theme;}catch{document.documentElement.dataset.theme='dark';}</script>
</head>
<body class:list={{"immersive-home":immersive}}>
  <a class="skip" href="#main">Skip to content</a>
  <Atmosphere/>
  <slot name="arrival"/>
  <div class="shell deck-shell">
    <header class="deck-header">
      <a class="deck-brand" href="/" aria-label="Aryan Basantani home"><BrandMark/></a>
      <div class="deck-settings">
        <button id="intro-replay" type="button" hidden aria-label="Play intro animation">
          <svg class="btn-glyph intro-replay-glyph" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4.2 3.1a.6.6 0 0 1 .9-.52l8.1 4.9a.6.6 0 0 1 0 1.04l-8.1 4.9A.6.6 0 0 1 4.2 12.9V3.1Z"/></svg>
          <span id="intro-replay-label">Play intro</span>
        </button>
        <button id="theme-toggle" type="button" hidden transition:persist="theme-control">
          <svg class="btn-glyph" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="5.5"/><path d="M8 2.5a5.5 5.5 0 0 1 0 11Z" fill="currentColor" stroke="none"/></svg>
          <span id="theme-label">Dark</span>
        </button>
      </div>
      <nav class="deck-nav" aria-label="Main navigation">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
        <a href="/work/" aria-current={path.startsWith('/work') ? 'page' : undefined}>Work</a>
        <a href="/interests/" aria-current={path.startsWith('/interests') ? 'page' : undefined}>Interests</a>
        <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
        <a href="/resume.pdf" target="_blank" rel="noreferrer">Resume <span aria-hidden="true">↗</span></a>
        <a href="#contact">Get in touch</a>
      </nav>
    </header>
    <main id="main"><slot/></main>
    <footer id="contact" class="deck-footer">
      <div class="footer-lead">
        <p class="mono">GET IN TOUCH</p>
        <h2>Open to the next<br/>useful problem<span>.</span></h2>
      </div>
      <div class="footer-actions">
        <a class="footer-email-bar" href={`mailto:${person.email}`}>
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg>
          <span class="footer-email-text">{person.email}</span>
          <svg class="footer-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10"/></svg>
        </a>
        <div class="footer-links-row">
          <a class="footer-icon-btn" href={person.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn profile" title="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="5" r="2"/><path d="M3 9h4v12H3zm7 0h4v2c1.2-1.7 2.8-2.5 4.5-2.5 2.6 0 3.5 1.8 3.5 5V21h-4v-6.6c0-1.7-.6-2.6-1.9-2.6-1.4 0-2.1 1-2.1 3.1V21h-4z"/></svg>
            <span class="sr-only">LinkedIn</span>
          </a>
          <a class="footer-icon-btn footer-x" href={person.x} target="_blank" rel="noreferrer" aria-label="X profile: arbs_42" title="X · @arbs_42">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 3 12.6 18H20L7.4 3ZM4 21 19.5 3"/></svg>
            <span class="sr-only">X · @arbs_42</span>
          </a>
          <a class="footer-pill-btn" href="/resume.pdf" target="_blank" rel="noreferrer" aria-label="Open résumé PDF">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>
            <span>Resume</span>
            <svg class="footer-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10"/></svg>
          </a>
          <a class="footer-pill-btn footer-cta-btn" href={person.calendly} target="_blank" rel="noopener noreferrer" data-open-booking aria-label="Let's chat — schedule a conversation">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M16 3v4M8 3v4M3 11h18M8 15h2M14 15h2"/></svg>
            <span>Let’s chat</span>
            <svg class="footer-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10"/></svg>
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>ARYAN BASANTANI · INDIA 2026</span>
        <span aria-label="Made with love">Made with <b class="footer-heart" aria-hidden="true">♥</b></span>
        <a class="footer-top-link" href="#main">Back to top ↑</a>
      </div>
    </footer>
  </div>
  <GlobalMusicPlayer/>
  <ChatWidget/>
  <BookingSheet/>
  <script is:inline src="/theme.js" defer></script>
  <script is:inline src="/atmosphere.js" defer></script>
  <script is:inline src="/deck.js" defer></script>
  <script is:inline src="/anilist.js" defer></script>
  <script is:inline src="/booking.js" defer></script>
  {immersive && <script is:inline src="/arrival.js" defer data-astro-rerun></script>}
</body>
</html>
