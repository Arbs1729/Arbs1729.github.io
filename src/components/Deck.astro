---
import '../styles/global.css';
import '../styles/deck.css';
import '../styles/revamp.css';
import {person} from '../data/portfolio';
import ChatWidget from './ChatWidget.astro';
import Atmosphere from './Atmosphere.astro';
import BrandMark from './BrandMark.astro';
const {title='Product, technology & finance',description=person.description,immersive=false}=Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site || 'https://aryanbasantani.me');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title} — {person.name}</title>
  <meta name="description" content={description}/>
  <meta name="robots" content="index,follow"/>
  <meta name="color-scheme" content="dark light"/>
  <link rel="canonical" href={canonical}/>
  <meta property="og:title" content={`${title} — ${person.name}`}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={canonical}/>
  <link rel="icon" href="/favicon.svg"/>
  <script is:inline>try{const saved=localStorage.getItem('aryan-theme');const theme=saved==='system'||saved==='light'||saved==='dark'?saved:'dark';if(theme==='system')delete document.documentElement.dataset.theme;else document.documentElement.dataset.theme=theme;if(localStorage.getItem('deck-motion')==='off')document.documentElement.dataset.motion='off';}catch{document.documentElement.dataset.theme='dark';}</script>
</head>
<body class:list={{"immersive-home":immersive}}>
  <a class="skip" href="#main">Skip to content</a>
  <Atmosphere/>
  <slot name="arrival"/>
  <div class="shell deck-shell">
    <header class="deck-header">
      <a class="deck-brand" href="/" aria-label="Aryan Basantani home"><BrandMark/></a>
      <nav aria-label="Main navigation">
        <a href="/work/" aria-current={path.startsWith('/work') ? 'page' : undefined}>Work</a>
        <a href="/interests/" aria-current={path.startsWith('/interests') ? 'page' : undefined}>Interests</a>
        <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
        <a href="#contact">Get in touch</a>
      </nav>
      <div class="deck-settings">
        <button id="motion-toggle" type="button" hidden aria-pressed="false">Motion <span>on</span></button>
        <button id="theme-toggle" type="button" hidden><span aria-hidden="true">◐</span> <span id="theme-label">Dark</span></button>
      </div>
    </header>
    <main id="main"><slot/></main>
    <footer id="contact" class="deck-footer">
      <div><p class="mono">GET IN TOUCH</p><h2>Open to the next<br/>useful problem<span>.</span></h2></div>
      <div class="footer-actions">
        <div class="footer-primary">
          <a class="footer-contact footer-email" href={`mailto:${person.email}`}>
            <span class="mono">EMAIL</span><strong>{person.email}</strong><span aria-hidden="true">↗</span>
          </a>
          <a class="footer-contact footer-resume" href="/resume.pdf" target="_blank" rel="noreferrer">
            <span class="mono">RÉSUMÉ</span><strong>Open PDF</strong><span aria-hidden="true">↗</span>
          </a>
        </div>
        <nav class="footer-socials" aria-label="Social profiles">
          <a href={person.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn profile" title="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="5" r="2"/><path d="M3 9h4v12H3zm7 0h4v2c1.2-1.7 2.8-2.5 4.5-2.5 2.6 0 3.5 1.8 3.5 5V21h-4v-6.6c0-1.7-.6-2.6-1.9-2.6-1.4 0-2.1 1-2.1 3.1V21h-4z"/></svg>
            <span class="sr-only">LinkedIn</span>
          </a>
          <a href={person.x} target="_blank" rel="noreferrer" aria-label="X profile: arbs_42" title="X · @arbs_42">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 3 12.6 18H20L7.4 3ZM4 21 19.5 3"/></svg>
            <span class="sr-only">X · @arbs_42</span>
          </a>
        </nav>
      </div>
      <div class="footer-bottom"><span>ARYAN AJAY BASANTANI</span><span>INDIA · 2026</span><span>Made with ❤️</span><a href="#main">Back to top ↑</a></div>
    </footer>
  </div>
  <ChatWidget/>
  <script is:inline src="/theme.js" defer></script>
  <script is:inline src="/atmosphere.js" defer></script>
  <script is:inline src="/deck.js" defer></script>
  {immersive && <script is:inline src="/arrival.js" defer></script>}
</body>
</html>
