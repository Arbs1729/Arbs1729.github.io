---
import Icon from './Icon.astro';
import MusicPlayer from './MusicPlayer.astro';
import { stories } from '../data/portfolio';
const selected = stories.filter(story => story.selected);
---
<section id="home-base" class="home-intro station-deck" aria-labelledby="home-title">
  <div class="station-horizon" aria-hidden="true"></div>
  <div class="station-mullion station-mullion-l" aria-hidden="true"></div>
  <div class="station-mullion station-mullion-r" aria-hidden="true"></div>
  <span class="hud-corner hud-tl" aria-hidden="true"></span>
  <span class="hud-corner hud-tr" aria-hidden="true"></span>
  <span class="hud-corner hud-bl" aria-hidden="true"></span>
  <span class="hud-corner hud-br" aria-hidden="true"></span>
  <div class="intro-primary">
    <h1 id="home-title">Hi, I’m Aryan.</h1>
    <div class="intro-copy">
      <p>I’m a tech enthusiast with a background in computer science and finance. I’ve worked across product, strategy, analytics and financial systems, and I enjoy understanding how technology and business decisions fit together.</p>
      <p>Outside work, I follow macroeconomics and geopolitics, and unwind with Formula 1, anime, films and music. Lately, I’ve been exploring AI and revisiting my computer science foundations.</p>
      <p>I’m looking for my next chapter: a product role where I can combine technical and business understanding to build useful products.</p>
    </div>
  </div>
  <div class="intro-navigation">
    <p class="intro-prompt">EXPLORE</p>
    <nav class="home-paths" aria-label="Explore Aryan’s portfolio">
      <a href="/work/"><span class="room-idx"><i class="room-led" aria-hidden="true"></i><span class="room-num">01</span><span>Work</span></span><Icon /></a>
      <a href="/interests/"><span class="room-idx"><i class="room-led" aria-hidden="true"></i><span class="room-num">02</span><span>Interests</span></span><Icon /></a>
      <a href="/about/"><span class="room-idx"><i class="room-led" aria-hidden="true"></i><span class="room-num">03</span><span>About</span></span><Icon /></a>
    </nav>
  </div>
  <div class="intro-shortcuts">
    <p class="intro-prompt">ON THIS PAGE</p>
    <nav class="home-jumps" aria-label="Jump within the homepage">
      <a href="#selected-work">
        <span>Selected work</span>
        <svg class="btn-glyph" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3.2v9.6m0 0-3.5-3.5M8 12.8l3.5-3.5"/></svg>
      </a>
      <a class="intro-play" href="#listening" data-start-music aria-label="Play A Town with an Ocean View and open the music section" title="Play the soundtrack">
        <svg class="btn-glyph play-glyph" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4.2 3.1a.6.6 0 0 1 .9-.52l8.1 4.9a.6.6 0 0 1 0 1.04l-8.1 4.9A.6.6 0 0 1 4.2 12.9V3.1Z"/></svg>
        <span>Play soundtrack</span>
      </a>
    </nav>
  </div>
</section>

<section id="selected-work" class="home-section home-work" aria-labelledby="work-title">
  <div class="editorial-head">
    <p class="mono">SELECTED WORK</p>
    <div class="editorial-head-main">
      <h2 id="work-title">A few things worth opening.</h2>
      <a class="section-action" href="/work/">Complete work index <Icon /></a>
    </div>
  </div>
  <div class="work-lines">
    {selected.map((story, index) => <a href={`/work/${story.slug}/`}>
      <span class="work-number">0{index + 1}</span>
      <span>
        <small>{story.organisation} · {story.kind}</small>
        <strong>{story.title}</strong>
        <p>{story.deck}</p>
        {story.impact && <span class="work-impact">{story.impact}</span>}
      </span>
      <Icon />
    </a>)}
  </div>
</section>

<section id="listening" class="home-section home-music" aria-labelledby="home-music-heading">
  <div class="editorial-head">
    <p class="mono">ON ROTATION</p>
    <div class="editorial-head-main">
      <h2 id="home-music-heading">Music that changes the temperature of a room.</h2>
      <a class="section-action" href="/interests/#music">All interests &amp; tabs <Icon /></a>
    </div>
  </div>
  <MusicPlayer compact />
</section>
