---
import { musicPicks } from '../data/culture';

const tracks = musicPicks.map(({ title, artist, album, youtubeId, audio }) => ({
  title,
  artist,
  album,
  youtubeId,
  audio,
}));
const first = tracks[0];
---

<section
  class="music-dock"
  data-global-music
  data-catalog={JSON.stringify(tracks)}
  data-active-index="0"
  aria-label="Persistent music player"
  hidden
  transition:persist="global-music"
>
  <div class="music-dock-card">
    <div class="music-dock-mobile-progress" aria-hidden="true"><i></i></div>

    <div class="music-dock-topbar" data-dock-drag-handle title="Drag to move player">
      <div class="music-dock-grip" aria-hidden="true">
        <svg viewBox="0 0 16 10" width="14" height="9" fill="currentColor">
          <circle cx="3" cy="2.5" r="1.2" /><circle cx="8" cy="2.5" r="1.2" /><circle cx="13" cy="2.5" r="1.2" />
          <circle cx="3" cy="7.5" r="1.2" /><circle cx="8" cy="7.5" r="1.2" /><circle cx="13" cy="7.5" r="1.2" />
        </svg>
        <span class="mono">DRAG</span>
      </div>
      <div class="music-dock-win">
        <a class="dock-mini-btn" data-shelf-youtube href={`https://music.youtube.com/watch?v=${first.youtubeId}`} target="_blank" rel="noreferrer" aria-label="Open in YouTube Music" title="Open in YouTube Music">
          <span class="yt-mark" aria-hidden="true">▶</span>
        </a>
        <button class="dock-mini-btn dock-close-btn" type="button" data-shelf-close aria-label="Close music player" title="Close">×</button>
      </div>
    </div>

    <div class="music-dock-stage" data-video-frame>
      <div id="global-youtube-player" data-youtube-mount></div>
      <div class="music-dock-drag-shield" aria-hidden="true"></div>
      <div class="video-fallback" data-video-fallback hidden>
        <span class="music-dock-disc" aria-hidden="true"><i></i></span>
        <strong>Local audio</strong>
        <small>YouTube unavailable</small>
      </div>
    </div>

    <div class="music-dock-panel">
      <div class="music-dock-scrubber">
        <input data-shelf-progress type="range" min="0" max="1000" value="0" aria-label="Track progress" />
        <div class="music-dock-times">
          <span class="dock-time" data-shelf-current>0:00</span>
          <span class="dock-time" data-shelf-duration>0:00</span>
        </div>
      </div>

      <div class="music-dock-meta-row">
        <div class="music-dock-track">
          <span class="music-dock-disc dock-local-disc" aria-hidden="true"><i></i></span>
          <div class="music-dock-copy">
            <strong data-shelf-title>{first.title}</strong>
            <small data-shelf-meta>{first.artist} · {first.album}</small>
          </div>
        </div>
      </div>

      <div class="music-dock-controls" aria-label="Playback controls">
        <button class="dock-btn dock-prev" type="button" data-shelf-prev aria-label="Previous track" title="Previous track">‹</button>
        <button class="dock-btn dock-play" type="button" data-shelf-toggle aria-label={`Play ${first.title}`} title="Play or pause">▶</button>
        <button class="dock-btn dock-next" type="button" data-shelf-next aria-label="Next track" title="Next track">›</button>
      </div>
    </div>
  </div>

  <audio data-global-audio preload="none" hidden></audio>
</section>
