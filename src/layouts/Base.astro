---
import '../styles/global.css';
import { person } from '../data/portfolio';
import Icon from '../components/Icon.astro';
const { title = 'Product, technology & finance', description = person.description } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const is404 = path === '/404.html' || path === '/404/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" /><meta name="robots" content={is404 ? 'noindex, follow' : 'index, follow'} />
    {!is404 && <link rel="canonical" href={canonical} />}
    <meta property="og:url" content={canonical} />
    <title>{title} — {person.name}</title><meta name="description" content={description} /><meta name="author" content={person.name} />
    <meta property="og:title" content={`${title} — ${person.name}`} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>try {const t=localStorage.getItem('aryan-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t;}catch{}</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a><div class="shell">
      <header class="header"><a class="brand" href="/" aria-label="Aryan Basantani, home">aryan<span>.</span></a><nav aria-label="Main navigation"><a href="/work/" aria-current={path.startsWith('/work/') ? 'page' : undefined}>Work</a><a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About</a><a href="#contact">Contact</a></nav><button id="theme-toggle" class="theme" type="button" hidden aria-label="Colour theme: system. Switch to light."><span aria-hidden="true">◐</span> <span id="theme-label">Auto</span></button></header>
      <main id="main"><slot /></main>
      <footer id="contact" class="footer"><div><h2>Let’s talk.</h2><p>Product, technology, and financial systems.</p></div><div class="contact-links"><a href={`mailto:${person.email}`}><Icon name="mail" />Email</a><a href={person.linkedin}><Icon name="linkedin" />LinkedIn</a><a href="/resume.pdf"><Icon name="download" />Résumé <span class="subtle">PDF</span></a></div><small>Aryan Ajay Basantani · India</small></footer>
    </div><script is:inline src="/theme.js" defer></script>
  </body>
</html>
