{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aryan-portfolio-copilot",
  "main": "index.mjs",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_FALLBACK_MODEL": "gemini-3.5-flash-lite",
    "ALLOWED_ORIGINS": "https://aryanbasantani.me,http://localhost:4176,http://127.0.0.1:4176,http://127.0.0.1:4321,http://localhost:4321"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "2026091201",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
